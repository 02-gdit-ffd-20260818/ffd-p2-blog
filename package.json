{
  "name": "ffd-p2-blog",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "start:api": "node server/index.js",
    "db:migrate": "node database/migrate.mjs",
    "db:seed": "node database/seed.mjs",
    "db:verify": "node database/verify.mjs",
    "db:backup": "node database/backup.mjs",
    "db:restore": "node database/restore.mjs",
    "db:mysql:migrate": "node database/mysql/migrate.mjs",
    "db:mysql:seed": "node database/mysql/seed.mjs",
    "db:mysql:verify": "node database/mysql/verify.mjs",
    "db:mysql:backup": "node database/mysql/backup.mjs",
    "db:mysql:restore": "node database/mysql/restore.mjs",
    "db:postgres:migrate": "node database/postgres/migrate.mjs",
    "db:postgres:seed": "node database/postgres/seed.mjs",
    "db:postgres:verify": "node database/postgres/verify.mjs",
    "db:postgres:backup": "node database/postgres/backup.mjs",
    "db:postgres:restore": "node database/postgres/restore.mjs",
    "check": "node scripts/check-project.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:component": "vitest run",
    "test": "npm run test:unit && npm run test:component",
    "build": "vite build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.15.0",
    "pg": "^8.16.3",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
